{
  "name": "hesabaty",
  "productName": "Hesabaty",
  "version": "1.1.5",
  "description": "برنامج حساباتي",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.hesabaty.app",
    "productName": "Hesabaty",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "icon.png",
      "icon.ico",
      "license.html"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hesabaty-${version}-Setup.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "حساباتي",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1025"
    },
    "publish": {
      "provider": "github",
      "owner": "anamasry816-blip",
      "repo": "hesabaty-updates",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/anamasry816-blip/hesabaty-updates.git"
  }
}
